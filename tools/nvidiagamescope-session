#!/bin/sh
# Launch a Steam Big Picture session inside NVIDIAGamescope.
#
# Display managers invoke this script without arguments. Passing arguments is
# useful for testing another session command, for example:
#   nvidiagamescope-session steam -gamepadui
set -eu

if ! command -v nvidiagamescope >/dev/null 2>&1; then
    printf '%s\n' 'nvidiagamescope-session: nvidiagamescope is not installed' >&2
    exit 127
fi

if [ "$#" -eq 0 ]; then
    set -- steam -gamepadui
fi

# Force GPU composition in the experimental session by default. NVIDIA DRM
# direct scan-out/plane paths have produced tiled/RGB-static artifacts on some
# driver/display combinations; correctness is preferred over latency here.
# Set NVIDIAGAMESCOPE_PROFILE=performance to test direct scan-out instead.
profile=${NVIDIAGAMESCOPE_PROFILE:-safe}
case "$profile" in
    safe)
        exec nvidiagamescope --backend drm --steam --keep-alive --force-composition -- "$@"
        ;;
    performance)
        exec nvidiagamescope --backend drm --steam --keep-alive -- "$@"
        ;;
    *)
        printf '%s\n' "nvidiagamescope-session: unknown profile '$profile' (use safe or performance)" >&2
        exit 2
        ;;
esac
